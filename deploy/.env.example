# ──────────────────────────────────────────────────────────────
#  OmniRoute custom image — deployment env example
#
#  This file is NOT the full env contract. It lists only:
#    • Docker / compose-specific vars
#    • vars this deployment customizes vs upstream defaults
#    • deployment-critical security vars
#
#  The authoritative contract is upstream's .env.example
#  (repo root, ~3.5k lines, maintained upstream):
#    https://github.com/diegosouzapw/OmniRoute/blob/v3.8.51/.env.example
#  Do NOT fork it here — a fork goes stale silently (this file
#  once pinned claude-cli/2.1.195 while upstream shipped 2.1.258).
#
#  Live values are managed in the Dokploy UI (Dokploy overwrites
#  deploy/.env on deploy) — treat this file as documentation.
#  The repo-root .env.example + docs/reference/ENVIRONMENT.md pair
#  is the checked, synced contract (scripts/check/check-env-doc-sync.mjs).
# ──────────────────────────────────────────────────────────────

# ═══ Docker / compose-specific ═══
# Not in the upstream .env.example — compose file local.
COMPOSE_PROJECT_NAME=omniroute
OMNIROUTE_DATA_VOLUME=omniroute-data
OMNIROUTE_REDIS_VOLUME=omniroute-redis-data
# Host port the compose file maps to container 20128.
OMNIROUTE_HOST_PORT=20128
# Container runtime heap (MB). The app's own knob is OMNIROUTE_MEMORY_MB.
NODE_OPTIONS=--max-old-space-size=512
# Tells the entrypoint to give docker-specific advice.
CONTAINER_HOST=docker

# Deployment hints (commented — set in the Dokploy UI when needed):
# Hostnames that count as "local" for LOCAL_ONLY routes (compose service names).
# LOCAL_HOSTNAMES=omlx,mlx-audio
# Trust list for proxies on PUBLIC addresses. Private-LAN and Cloudflare
# proxies are trusted by default — leave unset for a Traefik/LAN proxy.
# OMNIROUTE_TRUSTED_PROXIES=

# ═══ Deployment-critical security ═══
# REQUIRED — generate and rotate before first login
# (openssl rand -base64 48 / openssl rand -hex 32).
JWT_SECRET=
API_KEY_SECRET=
INITIAL_PASSWORD=CHANGEME
STORAGE_ENCRYPTION_KEY=
STORAGE_ENCRYPTION_KEY_VERSION=v1

# ⚠ The image defaults REQUIRE_API_KEY=true, but a value here (or in the
# Dokploy env) OVERRIDES it. Leave unset unless the deployment is on a
# trusted network only.
# REQUIRE_API_KEY=false
# Set true whenever the dashboard is reachable off-loopback.
# AUTH_COOKIE_SECURE=false

# ═══ Customized vs upstream defaults ═══
# MCP tool allowlist for this deployment (upstream default: unset = all).
MCP_TOOL_ALLOW=omniroute_list_combos,omniroute_route_request,omniroute_web_search,omniroute_web_fetch,omniroute_agent_skills_list,omniroute_agent_skills_get,omniroute_agent_skills_coverage,omniroute_skills_list,omniroute_skills_execute

# Pinned upstream-CLI User-Agents. Upstream derives these from the embedded
# CLI versions and maintains them in its own .env.example — set only to
# override. (A CLAUDE_USER_AGENT pin used to live here and went stale;
# upstream's copy is the one to trust.)
CODEX_USER_AGENT="codex-cli/0.142.0 (Windows 10.0.26200; x64)"
QWEN_USER_AGENT="QwenCode/0.19.3 (linux; x64)"

# ── Build-time knobs (informational only — NOT consumed here) ──
# This .env is read at RUNTIME by the container. The image build
# knobs live in .github/workflows/build-publish.yml build-args
# (OMNIROUTE_USE_TURBOPACK=0, OMNIROUTE_BUILD_MEMORY_MB=12288)
# and the deploy/Dockerfile defaults. Setting them here has NO
# effect — deploy/docker-compose.yml is pull-only (no build block),
# so there is no `docker compose build` to feed them to.
# To build locally with custom knobs, pass --build-arg to
# `docker buildx build` (see deploy/build-and-push.sh).

# ═══ Everything else ═══
# Redis URL, BASE_URL/CLOUD_URL, OAuth client ids (baked in via
# resolvePublicCred), proxy toggles, rate limits, pipeline knobs,
# provider cooldowns, stream recovery, playground/inspector settings,
# … all come from upstream's .env.example. Unset here = upstream default.
